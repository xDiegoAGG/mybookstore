# Plantilla para el build de produccion del frontend
#
# Despues de desplegar el stack `infra/pulumi/api-gateway`, copia este archivo
# como `.env.production` y reemplaza el valor de VITE_API_URL con el output
# `apiInvokeUrl` del stack:
#
#   cd infra/pulumi/api-gateway
#   pulumi stack output apiInvokeUrl
#
# Despues haz:
#
#   cd frontend
#   npm run build
#   aws s3 sync dist/ s3://<bucket-name>/ --delete
#
# (El script infra/pulumi/scripts/build-and-deploy-frontend.sh hace todo lo
# anterior automaticamente.)

VITE_API_URL=https://REEMPLAZAR_CON_API_GATEWAY_URL.execute-api.us-east-1.amazonaws.com
